# ========================================
# 企业知识库 - 环境变量配置
# ========================================

# ----------------------------------------
# LLM Provider API Keys (必填至少一个)
# ----------------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key
QWEN_API_KEY=your-qwen-api-key
GLM_API_KEY=your-glm-api-key
OPENAI_API_KEY=your-openai-api-key

# ----------------------------------------
# MySQL 数据库配置
# ----------------------------------------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=knowledge_hub
MYSQL_USER=kh_user
MYSQL_PASSWORD=kh_password
MYSQL_PORT=3306

# ----------------------------------------
# 应用端口配置
# ----------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8000

# ----------------------------------------
# 应用配置
# ----------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ----------------------------------------
# 数据存储路径
# ----------------------------------------
CHROMA_PERSIST_DIR=./data/db/chroma
UPLOAD_DIR=./uploads
